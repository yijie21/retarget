# Model weights / checkpoints — fetched by setup/02_fetch_weights.sh, never committed
weights/

# Weights that live inside the submoduled repos (symlinked/downloaded at setup).
modules/*/checkpoints/
modules/HaWoR/weights/
modules/HaWoR/thirdparty/*/weights/
modules/HaWoR/_DATA/

# Python
**/__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Vendored sam3 package: drop generated outputs
modules/sam3/output/

# Pipeline run outputs (reconstruction is written next to the input video — large,
# fully reproducible by re-running run_pipeline*.sh). Never commit.
runs/
clean_release/
all_frames/
video_segmentation/
obj_tracking_out/
perframe_tracking_*/
tracking_output_every_frame/
*_pointmap.npy
*_intrinsics.txt
*_intrinsics.npy
output_tapir_*

# OS / editor
.DS_Store
*.swp
